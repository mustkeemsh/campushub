# ==============================================================================
# CollegeHub Environment Configuration (.env.example)
# Duplicate this file to .env and configure with your environment values.
# NEVER commit real secret keys to source control.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Supabase Project Connection
# (When provided, CollegeHub connects live to Supabase PostgreSQL; 
#  if omitted, CollegeHub automatically runs on its local verified store)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
SUPABASE_KEY=sb_secret_your_secret_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional Direct PostgreSQL Pooler Connection URI (for seed_db.py)
# DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-admin-password

# Google OAuth 2.0 Credentials (Optional direct OAuth; Supabase Google OAuth also available)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Gmail SMTP Email Delivery (for sending 6-digit password reset codes directly to Gmail)
# For Gmail, generate a 16-character Google App Password:
# Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-organization-or-email@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
SMTP_FROM_NAME=CollegeHub Admissions
SMTP_USE_TLS=true

# AI Chatbot ("Ask CollegeHub") - get a key at https://console.anthropic.com
# Without a key the chatbot falls back to FAQ-only answers.
ANTHROPIC_API_KEY=
# CHATBOT_MODEL=claude-haiku-5-5
# CHATBOT_MAX_TOKENS=700
# CHATBOT_RATE_LIMIT_PER_MIN=15
